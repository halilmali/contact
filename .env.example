# Production Deployment Configuration
# Copy this to .env and update the values

NODE_ENV=production
PORT=3000

# Google OAuth Credentials (from Google Cloud Console)
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET

# Production URL and redirect configuration
# If your app is deployed to a custom domain, set BASE_URL and/or REDIRECT_URI explicitly
BASE_URL=https://your-production-domain.com/mailing
REDIRECT_URI=https://your-production-domain.com/mailing/oauth2callback

# Session Secret (change this to a random secure string)
SESSION_SECRET=your-random-secret-key-here-change-this-in-production

# Optional: If behind a proxy
# TRUST_PROXY=true
